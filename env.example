# Supabase Configuration
# 請到 Supabase 專案設定中取得以下資訊
# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ========================================
# Notion API Configuration
# ========================================
# 請參考 NOTION_SETUP.md 取得詳細設定說明

# Notion Integration Token
# 1. 前往 https://www.notion.so/my-integrations
# 2. 點擊「New integration」建立新的整合
# 3. 複製 Internal Integration Token
NOTION_API_KEY=secret_your-notion-integration-token

# Notion 講座申請資料庫 ID
# 1. 開啟您的 Notion 資料庫頁面
# 2. 從網址列複製資料庫 ID（在網址中 notion.so/ 後面的 32 碼字串）
# 例如: https://notion.so/your-workspace/abc123def456... → abc123def456...
NOTION_LECTURE_APPLICATIONS_DB_ID=your-notion-database-id

# Notion 文章資料庫 ID
NOTION_POSTS_DB_ID=your-notion-posts-database-id

# Notion 回饋資料庫 ID
NOTION_TESTIMONIALS_DB_ID=your-notion-testimonials-database-id
