# n8n 基本設定
N8N_USER=admin
N8N_PASSWORD=請設定強密碼
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# Notion 設定
NOTION_API_KEY=secret_xxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facebook 設定
# 取得方式：https://developers.facebook.com/tools/explorer/
FACEBOOK_PAGE_ID=你的粉專ID
FACEBOOK_ACCESS_TOKEN=你的Facebook存取權杖

# Threads 設定
# Threads 使用 Instagram Graph API
THREADS_USER_ID=你的Instagram商業帳號ID
THREADS_ACCESS_TOKEN=你的Instagram存取權杖

# LINE 設定
# 取得方式：https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=你的LINE_Channel_Access_Token
LINE_GROUP_ID=你的LINE社群ID

# Skool 設定
# Skool 目前沒有官方 API，可能需要使用 Webhook 或自動化工具
SKOOL_API_KEY=如果有的話
SKOOL_COMMUNITY_ID=你的Skool社群ID
